# ---------------------------------------------------------------- Aplicação
# URL pública (usada em links de e-mail e downloads). Sem barra no final.
APP_URL=http://localhost:3000
# Segredo para assinar links temporários. Gere com: openssl rand -base64 48
APP_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# Permitir novos cadastros pela tela /cadastro
ALLOW_REGISTRATION=true
SESSION_TTL_DAYS=14

# ---------------------------------------------------------------- Banco e fila
DATABASE_URL=postgresql://labelhub:labelhub@localhost:5432/labelhub?schema=public
REDIS_URL=redis://localhost:6379
# Jobs de geração simultâneos por processo do worker (análise usa o dobro)
WORKER_CONCURRENCY=2

# ---------------------------------------------------------------- Armazenamento
# local = disco do servidor (dev ou servidor único; web e worker precisam ver a mesma pasta)
# s3    = Amazon S3 ou compatível (R2, MinIO, Spaces, Wasabi)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
# S3_BUCKET=labelhub-arquivos
# S3_REGION=sa-east-1
# S3_ENDPOINT=                # vazio para AWS; ex.: https://<conta>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=           # vazio para usar a IAM role da máquina
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false   # true para MinIO
# Validade dos links de download (segundos)
SIGNED_URL_TTL_SECONDS=300

# ---------------------------------------------------------------- E-mail
# Sem SMTP_URL, os e-mails (recuperação de senha, convites) aparecem no log do servidor.
# SMTP_URL=smtps://usuario:senha@smtp.seuprovedor.com:465
MAIL_FROM="LabelHub Cloud <no-reply@seudominio.com.br>"

# ---------------------------------------------------------------- PDF
# Caminho do qpdf (opcional; abre PDFs protegidos por senha de proprietário e repara arquivos danificados)
# QPDF_PATH=/usr/bin/qpdf
